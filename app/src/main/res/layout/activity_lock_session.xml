<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_oled"
    android:padding="24dp"
    android:gravity="center">

    <ProgressBar
        android:id="@+id/glyphProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:max="100"
        android:progress="100"
        android:progressTint="@color/ink_white"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvBlockedNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 FOCUS SESSION ACTIVE"
        android:textColor="@color/accent_red"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <com.blockit.detox.views.BlockyMorphTimerView
        android:id="@+id/lockMorphTimer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnHoldParachute"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🪂 HOLD 3 SECONDS TO DEPLOY PARACHUTE"
        android:textColor="@color/accent_red"
        android:backgroundTint="@color/bg_card" />
</LinearLayout>
